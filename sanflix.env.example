# Copy this file to sanflix.env and fill it in, or just run `npm run dev`
# (it creates sanflix.env with random values for you). Never commit sanflix.env.

# Required. The admin password manages the library; the viewing password is what friends use.
# They must be different, each at least 12 characters.
SANFLIX_ADMIN_PASSWORD=
SANFLIX_VIEW_PASSWORD=
# Required. At least 32 characters; keeps everyone signed in across restarts.
SANFLIX_SECRET_KEY=

# Optional
# SANFLIX_PORT=5000
# SANFLIX_HOST=127.0.0.1          # 0.0.0.0 lets other devices on your Wi-Fi connect
# SANFLIX_LOCAL_BYPASS=on         # off = ask for the password even on this computer
# SANFLIX_SHARE_CREATORS=admin    # viewers = any signed-in viewer can create share links
# SANFLIX_HUB_STUN=               # empty disables the public STUN server used by the Shared Hub
